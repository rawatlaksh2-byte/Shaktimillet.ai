# Shakti Millets AgentTube overlay
# Copy these values into AgentTube's .env. NEVER commit real API keys.

NODE_ENV=production
PORT=3456
LOG_LEVEL=info

CHANNEL_NAME=Shakti Millets
DEFAULT_AUTHOR=Shakti Millets
TARGET_AUDIENCE=Indian households, millet-curious consumers, home cooks, retailers and wholesalers
YOUTUBE_REGION=IN
DEFAULT_PRIVACY_STATUS=private

# Start with one AI text provider.
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# Optional higher-quality voice / video providers.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
VIDEO_PROVIDER=slideshow
VIDEO_GENERATION_MODE=hybrid
VIDEO_MAX_GENERATED_SECONDS=60
VIDEO_RESOLUTION=720p
VIDEO_ASPECT_RATIO=9:16

AUTO_SHORTEN_CONTENT=true
AUTO_ADD_BACKLINKS=true
PRESERVE_FORMATTING=true
AUTO_RESIZE_IMAGES=true
MAX_IMAGE_WIDTH=1080
MAX_IMAGE_HEIGHT=1920
IMAGE_QUALITY=90

MAX_CONCURRENT_JOBS=1
GENERATION_STAGE_MAX_ATTEMPTS=2
ENABLE_ANALYTICS=true

# Set a long random value locally if you expose the dashboard beyond localhost.
API_KEY=

# Optional competitor YouTube channel IDs, comma-separated.
# COMPETITOR_CHANNELS=
